	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSAppleMusicUsageDescription</key>
	<string>brew.app uses Apple Music to fetch animated artwork for the lock screen wallpaper.</string>
	<key>NSAudioCaptureUsageDescription</key>
	<string>brew.app needs audio capture permission to display the real-time music waveform visualizer.</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>brew.app needs screen recording permission to capture screenshots for the AI assistant feature.</string>
	<key>SUEnableAutomaticChecks</key>
	<false/>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict/>
	</array>
